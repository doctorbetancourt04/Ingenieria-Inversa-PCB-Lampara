	(text "DRIVER LED TECNOLITE 50LHBLEDT65MV200" (exclude_from_sim no) (at 17.78 25.40 0) (effects (font (size 5.0 5.0) (bold yes)) (justify left bottom)) (uuid "b8cc4c40-ea2d-5289-b44b-6bf95896de8c"))
	(text "Esquematico reconstruido por ingenieria inversa de la PCB JT047-V1" (exclude_from_sim no) (at 17.78 33.02 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid "fd05f72f-74dc-5a52-a20b-d83620ac4123"))
	(text "NOTAS" (exclude_from_sim no) (at 17.78 236.22 0) (effects (font (size 1.8 1.8) (bold yes)) (justify left bottom)) (uuid "04702e14-cdd3-5941-ba9b-c5d5b0252198"))
	(text "1. GND = DC- = LED-. GND_U1 es la tierra flotante del controlador (fuente de Q1, nodo de conmutacion): no es la misma red que GND." (exclude_from_sim no) (at 17.78 241.30 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "9a6dc2d4-0957-5103-9c91-4780c1e9846e"))
	(text "2. DNP = no montado. LF1, L1 y RL1 estan puenteados por el cobre de la PCB." (exclude_from_sim no) (at 17.78 245.11 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "8bf7ae5e-7896-5337-b629-c3cf4f9449e3"))
	(text "3. RS1-RS4 en paralelo (0.31 ohm) sensan la corriente del inductor en ambos estados de Q1." (exclude_from_sim no) (at 17.78 248.92 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "5545faba-dbc5-5be1-960d-26f7f28c4f0f"))
	(text "4. D6 en paralelo con R7 descarga la compuerta de Q1 al apagar (transicion ON -> OFF rapida)." (exclude_from_sim no) (at 17.78 252.73 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "6889ae45-d9a4-50d5-8281-30c764181592"))
	(text "5. T1A y T1B son dos devanados del mismo nucleo T1. U1: controlador PWM SOT-23-6 marca H0TN, pines por funcion." (exclude_from_sim no) (at 17.78 256.54 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "1171a9af-fc2e-5e28-9abb-b5c2f5fcfda5"))
	(text "6. Q1 tiene el pad del drenaje despegado. Polaridad de D7 y D8 deducida del funcionamiento (falta medirla)." (exclude_from_sim no) (at 17.78 260.35 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "3e464f8a-d0c4-575b-ae36-2c0b5720bf60"))
